# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Estas duas chaves são públicas por natureza:
# a segurança dos dados vem das regras de RLS no banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key
